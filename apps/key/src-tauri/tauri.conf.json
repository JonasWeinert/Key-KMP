{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Key",
  "version": "0.1.0",
  "identifier": "dev.key.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Key",
        "width": 1440,
        "height": 920,
        "minWidth": 880,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 15
        },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://cdn.jsdelivr.net; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "macOS": {
      "frameworks": [
        "../../../vendor/pdfium/lib/libpdfium.dylib"
      ],
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
